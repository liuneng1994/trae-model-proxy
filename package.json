{
  "name": "trae-model-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Expose TRAE CLI models through OpenAI-compatible and Anthropic-compatible APIs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "setup": "node scripts/setup-clients.mjs",
    "setup:codex": "node scripts/setup-clients.mjs --codex-only",
    "setup:claude": "node scripts/setup-clients.mjs --claude-only",
    "setup:uninstall": "node scripts/setup-clients.mjs --uninstall",
    "install:all": "node scripts/install-all.mjs",
    "service": "node scripts/service.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:start": "node scripts/service.mjs start",
    "service:stop": "node scripts/service.mjs stop",
    "service:restart": "node scripts/service.mjs restart",
    "service:status": "node scripts/service.mjs status",
    "doctor": "node scripts/doctor.mjs",
    "capture": "node scripts/capture.mjs",
    "test": "node --test test/*.test.mjs",
    "test:clients": "RUN_CLIENT_SMOKE=1 node --test test/client-smoke.test.mjs",
    "test:live-search": "RUN_TRAE_LIVE=1 node --test test/live-search.test.mjs"
  }
}
